# Select exactly one profile: local or prod
SPRING_PROFILES_ACTIVE=local

# -----------------------------------------------------------------------------
# Local environment
# -----------------------------------------------------------------------------
LOCAL_DATASOURCE_URL=jdbc:postgresql://localhost:5432/OISO
LOCAL_DATASOURCE_USERNAME=postgres
LOCAL_DATASOURCE_PASSWORD=ssafy
LOCAL_TOUR_API_SERVICE_KEY=your-local-tour-api-service-key

LOCAL_KAKAO_CLIENT_ID=your-local-kakao-rest-api-key
LOCAL_KAKAO_CLIENT_SECRET=your-local-kakao-client-secret
LOCAL_KAKAO_REDIRECT_URI={baseUrl}/login/oauth2/code/kakao

LOCAL_GOOGLE_CLIENT_ID=your-local-google-client-id
LOCAL_GOOGLE_CLIENT_SECRET=your-local-google-client-secret
LOCAL_GOOGLE_REDIRECT_URI={baseUrl}/login/oauth2/code/google

LOCAL_JWT_SECRET_KEY=replace-with-at-least-32-random-bytes
LOCAL_JWT_ACCESS_TOKEN_VALIDITY=900000
LOCAL_JWT_REFRESH_TOKEN_VALIDITY=604800000
LOCAL_JWT_ACCESS_TOKEN_VALIDITY_SEC=900
LOCAL_JWT_REFRESH_TOKEN_VALIDITY_SEC=604800

LOCAL_OAUTH2_REDIRECT_URI=http://localhost:5173/login-success
LOCAL_OAUTH2_ALLOWED_REDIRECT_URIS=http://localhost:5173/login-success,https://oiso-fe.vercel.app/login-success
LOCAL_CORS_ALLOWED_ORIGINS=http://localhost:5173,https://oiso-fe.vercel.app
LOCAL_COOKIE_SECURE=false
LOCAL_COOKIE_SAME_SITE=Lax

# -----------------------------------------------------------------------------
# Production environment
# Do not commit real production secrets. Configure them on the deployment host.
# -----------------------------------------------------------------------------
PROD_DATASOURCE_URL=jdbc:postgresql://YOUR_PROD_DB_HOST:5432/YOUR_PROD_DB_NAME
PROD_DATASOURCE_USERNAME=your-prod-db-username
PROD_DATASOURCE_PASSWORD=your-prod-db-password
PROD_TOUR_API_SERVICE_KEY=your-prod-tour-api-service-key

PROD_KAKAO_CLIENT_ID=your-prod-kakao-rest-api-key
PROD_KAKAO_CLIENT_SECRET=your-prod-kakao-client-secret
PROD_KAKAO_REDIRECT_URI=https://oiso.duckdns.org/login/oauth2/code/kakao

PROD_GOOGLE_CLIENT_ID=your-prod-google-client-id
PROD_GOOGLE_CLIENT_SECRET=your-prod-google-client-secret
PROD_GOOGLE_REDIRECT_URI={baseUrl}/login/oauth2/code/google

PROD_JWT_SECRET_KEY=replace-with-a-different-production-secret
PROD_JWT_ACCESS_TOKEN_VALIDITY=900000
PROD_JWT_REFRESH_TOKEN_VALIDITY=604800000
PROD_JWT_ACCESS_TOKEN_VALIDITY_SEC=900
PROD_JWT_REFRESH_TOKEN_VALIDITY_SEC=604800

PROD_OAUTH2_REDIRECT_URI=https://oiso-fe.vercel.app/login-success
PROD_OAUTH2_ALLOWED_REDIRECT_URIS=http://localhost:5173/login-success,https://oiso-fe.vercel.app/login-success
PROD_CORS_ALLOWED_ORIGIN=http://localhost:5173
PROD_COOKIE_SECURE=true
PROD_COOKIE_SAME_SITE=None

# -----------------------------------------------------------------------------
# Shared provider/API settings (normally unchanged between profiles)
# -----------------------------------------------------------------------------
TOUR_API_BASE_URL=http://apis.data.go.kr
TOUR_API_OPERATION_PATH=/B551011/KorService2/areaBasedList2
TOUR_API_FESTIVAL_OPERATION_PATH=/B551011/KorService2/searchFestival2
TOUR_API_DETAIL_COMMON_OPERATION_PATH=/B551011/KorService2/detailCommon2
TOUR_API_DETAIL_INFO_OPERATION_PATH=/B551011/KorService2/detailInfo2
TOUR_API_PAGE_SIZE=1000
TOUR_API_MOBILE_OS=ETC
TOUR_API_MOBILE_APP=AppTest
TOUR_API_ARRANGE=C
TOUR_API_L_DONG_REGN_CD=47
TOUR_API_L_DONG_SIGNGU_CD=130
TOUR_API_CONTENT_TYPE_IDS=
TOUR_DATA_TOUR_SPOTS_CRON=0 0 3 * * *
TOUR_DATA_FESTIVALS_CRON=0 10 3 * * *
TOUR_DATA_ACCOMMODATIONS_CRON=0 0 5 * * *

KAKAO_AUTH_METHOD=client_secret_post
KAKAO_GRANT_TYPE=authorization_code
KAKAO_SCOPE=profile_nickname,profile_image
KAKAO_CLIENT_NAME=Kakao
KAKAO_AUTH_URI=https://kauth.kakao.com/oauth/authorize
KAKAO_TOKEN_URI=https://kauth.kakao.com/oauth/token
KAKAO_USER_INFO_URI=https://kapi.kakao.com/v2/user/me
KAKAO_USER_NAME_ATTR=id
GOOGLE_SCOPE=profile,email
