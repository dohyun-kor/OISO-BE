import java.sql.*;
var db=DriverManager.getConnection(System.getenv("LOCAL_DATASOURCE_URL"),System.getenv("LOCAL_DATASOURCE_USERNAME"),System.getenv("LOCAL_DATASOURCE_PASSWORD"));db.setAutoCommit(false);
var q=db.createStatement();
String[] fields={"sub_title","summary","intro","story_title","story","tip","comment","did_you_know"};
for(var f:fields){q.executeUpdate("UPDATE public.\"TourStory\" SET "+f+"=btrim(regexp_replace(regexp_replace("+f+", '<[^>]+>', '', 'g'), E'\\n?\\s*\\(출처\\s*[:：][^)]*\\)', '', 'gi')), updated_at=now() WHERE "+f+" IS NOT NULL AND ("+f+" ~ '<[^>]+>' OR "+f+" ~* '출처\\s*[:：]')");}
var p=db.prepareStatement("UPDATE public.\"TourStory\" SET summary=?,intro=?,story_title=?,story=?,tip=?,comment=?,did_you_know=?,updated_at=now() WHERE spot_id=?");
void fix(long id,String summary,String intro,String storyTitle,String story,String tip,String comment,String know)throws Exception{p.setString(1,summary);p.setString(2,intro);p.setString(3,storyTitle);p.setString(4,story);p.setString(5,tip);p.setString(6,comment);p.setString(7,know);p.setLong(8,id);p.executeUpdate();}
fix(24,"신라의 정원을 현대적인 미디어아트와 식물 전시로 풀어낸 경주 동궁원의 테마 공간이에요.","라원은 ‘신라의 정원’이라는 이름처럼 천년 고도의 분위기를 빛과 식물, 전시 콘텐츠로 재해석한 공간이에요. 연못과 정원을 거닐다 전시관의 미디어아트까지 이어서 감상할 수 있어 가족 나들이와 저녁 산책에 잘 어울립니다.","빛으로 다시 피어난 신라의 정원","낮에는 식물과 정원의 색이 중심이 되고, 해가 지면 조명이 공간의 표정을 바꿔 놓아요. 전시관과 느티나무 광장, 연못이 하나의 동선으로 이어져 있어 신라의 자연관을 현대적인 감각으로 경험할 수 있습니다.","해 질 무렵 입장하면 낮의 정원과 야간 조명을 함께 볼 수 있어요. 미디어아트 상영 시간과 휴관일을 먼저 확인하고, 연못 주변까지 여유 있게 걸을 수 있도록 한 시간 이상 잡아 보세요.","전시관에서 정원으로 나오는 순간 달라지는 빛과 공기의 분위기를 천천히 느껴 보세요.","‘라원’이라는 이름에는 신라의 정원을 오늘의 방식으로 다시 보여 주려는 뜻이 담겨 있어요.");
fix(59,"신라의 동식물 문화를 현대적으로 재해석한 사계절 복합 체험 공간이에요.","경주 동궁원은 보문관광단지 입구에서 식물원과 버드파크를 함께 만날 수 있는 공간이에요. 동궁과 월지에서 진귀한 꽃과 새를 길렀다는 기록을 바탕으로 신라의 정원을 현대적인 체험 시설로 되살렸습니다.","신라의 정원이 오늘에 이어지는 곳","농업 시험포와 화훼 재배지였던 터는 식물 전시와 생태 체험을 즐기는 관광 공간으로 바뀌었어요. 유리 온실의 식물과 새 전시를 차례로 둘러보면 경주가 가진 역사 이야기와 자연 관찰의 재미를 한 자리에서 경험할 수 있습니다.","실내 온실은 계절과 날씨의 영향을 덜 받아 비 오는 날에도 좋아요. 버드파크까지 함께 본다면 관람 시간이 길어지므로 입장 마감과 체험 운영 시간을 확인하고 편한 신발을 준비하세요.","온실의 높고 밝은 공간에서 식물의 잎과 빛이 만드는 장면을 천천히 찾아보세요.","동궁과 월지에서 꽃과 진귀한 새를 길렀다는 기록이 오늘날 동궁원의 이야기 바탕이 되었어요.");
fix(109,"경주 남산 바위의 작은 석굴 안에 새겨진 신라 초기의 마애불이에요.","불곡 마애여래좌상은 남산 동쪽 골짜기의 바위를 깊게 파 만든 감실 안에 자리해요. 둥근 얼굴과 잔잔한 미소 때문에 ‘할매부처’라는 친근한 이름으로도 불리며, 남산에 남은 석불 가운데 이른 시기의 작품으로 평가됩니다.","바위 품에 앉은 할매부처","불상은 자연 바위를 지붕과 벽처럼 활용한 작은 석굴 안에 앉아 있어요. 화려한 장식보다 부드러운 표정과 단정한 자세가 먼저 눈에 들어오며, 신라인이 산과 바위를 신앙의 공간으로 받아들인 방식을 보여 줍니다.","대나무 숲을 지나는 짧은 산길이지만 비 온 뒤에는 바닥이 미끄러울 수 있어요. 불상 앞에서는 플래시와 접촉을 피하고, 오전의 부드러운 빛에 맞춰 조용히 감상해 보세요.","작은 감실 안의 온화한 표정을 마주하면 남산이 거대한 야외 박물관이라 불리는 이유를 느낄 수 있어요.","둥글고 자애로운 인상 덕분에 오래전부터 ‘할매부처’라는 이름으로 사랑받아 왔어요.");
fix(156,"작은 암자에 석조약사여래입상과 창건 설화가 함께 전해지는 곳이에요.","연지암은 경주 괘릉 안쪽의 조용한 마을 언덕에 자리한 작은 암자예요. 일제강점기 말 김연지화 보살이 창건했다고 전해지며, 대웅전에 모신 석조약사여래입상이 이곳의 중심을 이룹니다.","마을 언덕에 이어지는 작은 기도처","규모는 크지 않지만 대웅전과 요사채가 단정하게 놓여 있어 소박한 수행 공간의 분위기가 또렷해요. 석불을 찾아 봉안했다는 이야기도 전해져, 지역 주민의 기도와 돌봄 속에서 이어져 온 암자의 시간을 보여 줍니다.","주민 생활 공간과 가까운 작은 암자이므로 조용히 방문하고 법회 시간을 피하는 것이 좋아요. 경내 촬영 전에는 안내를 확인하고, 괘릉과 함께 둘러보면 이동 동선을 효율적으로 짤 수 있습니다.","화려함보다 오랫동안 이어진 지역의 믿음과 정성을 느끼며 머물러 보세요.","연지암의 이름은 창건자로 전해지는 김연지화 보살의 이름과 연결해 이야기돼요.");
fix(164,"청소년의 활동과 상담, 교육을 지원하는 경주의 열린 공공 문화 공간이에요.","경주시청소년수련관은 1995년 문을 연 뒤 청소년의 참여 활동과 상담, 교육을 지원해 온 시설이에요. 일반 관광 명소라기보다 지역 청소년과 가족이 프로그램을 통해 이용하는 생활 문화 공간에 가깝습니다.","청소년의 오늘을 응원하는 공간","수련관에서는 동아리와 체험 활동, 상담과 진로 지원 등 다양한 프로그램이 운영돼요. 건물 자체를 관람하기보다 사전에 참여 가능한 프로그램과 대상 연령을 확인할 때 이 공간의 역할을 제대로 경험할 수 있습니다.","자유 관람 시설이 아니므로 방문 전에 공식 일정에서 모집 대상과 신청 방법을 확인하세요. 프로그램 시작보다 여유 있게 도착해 접수와 안전 안내를 마치는 것이 좋아요.","경주의 청소년들이 배우고 만나며 자신의 가능성을 넓혀 가는 일상 가까운 공간이에요.","1995년 개관한 뒤 청소년 활동뿐 아니라 상담과 자립 지원까지 폭넓게 맡아 왔어요.");
fix(167,"『삼국유사』에 기록된 인용사의 터로 추정되는 신라 사찰 유적이에요.","인왕동 사지는 태종 무열왕의 둘째 아들 김인문을 위해 세운 인용사의 터로 추정돼요. 남아 있는 유구는 많지 않지만, 왕실 인물의 안녕과 극락왕생을 빌었던 신라 불교의 한 장면을 전합니다.","한 사람을 위한 기도가 사찰이 되다","김인문이 당나라에 머물던 시기 신라 사람들은 그의 무사 귀환을 바라며 관음도량을 열었다고 해요. 그가 귀국길에 세상을 떠난 뒤에는 극락왕생을 비는 미타도량으로 바뀌었다는 기록이 남아, 당시 신앙과 국제 관계를 함께 생각하게 합니다.","건물보다 터와 기록을 통해 이해하는 유적이라 현장 안내판을 먼저 읽는 것이 좋아요. 인근 월성과 동궁과 월지를 함께 둘러보면 신라 왕경 안에서 이 사찰이 놓였던 위치를 짐작하기 쉽습니다.","눈에 보이는 유구가 적을수록 기록 속 사람과 당시의 바람을 떠올리며 걸어 보세요.","인용사는 승려나 왕이 아닌 김인문 개인의 안녕을 위해 세운 이른 사례로 알려져 있어요.");
fix(178,"무열왕릉 뒤편 구릉에 나란히 자리한 네 기의 대형 신라 고분이에요.","서악동 고분군은 태종 무열왕릉 뒤편의 완만한 구릉에 자리한 네 기의 큰 무덤이에요. 둥근 봉분과 일부 드러난 둘레돌에서 대릉원 일대 고분과 다른 통일신라 왕릉의 구조를 살펴볼 수 있습니다.","왕릉 뒤 구릉에 겹쳐진 신라의 시간","무덤의 주인은 명확히 밝혀지지 않았지만 규모와 위치로 보아 신라 왕실과 밀접한 인물들의 묘역으로 여겨져요. 자연스러운 능선을 따라 이어지는 봉분은 서악 일대가 오랫동안 중요한 장송 공간이었음을 보여 줍니다.","무열왕릉을 먼저 보고 뒤편 구릉으로 이동하면 고분군의 배치를 이해하기 쉬워요. 봉분에 오르지 말고 정해진 길에서 크기와 간격을 비교해 보세요. 늦은 오후에는 능선의 입체감이 잘 드러납니다.","한 걸음 떨어져 네 봉분과 주변 산세를 함께 바라보면 묘역을 고른 옛사람들의 시선을 상상할 수 있어요.","봉분 둘레에는 깬돌을 사용한 흔적이 남아 있어 대릉원 고분들과 다른 조성 방식을 살펴볼 수 있어요.");
fix(184,"신라 왕궁의 별궁과 연회 공간이었던 월지를 복원한 대표적인 야경 명소예요.","동궁과 월지는 신라 왕궁의 별궁과 연못이 있던 자리예요. 문무왕 때 조성된 뒤 왕자가 머물고 나라의 경사나 귀한 손님을 위한 연회가 열렸으며, 발굴된 토기 조각의 명문을 근거로 오늘의 이름을 되찾았습니다.","달빛 아래 되살아나는 신라 왕궁","연못은 어느 지점에서도 전체 모습이 한눈에 드러나지 않도록 굴곡지게 설계됐어요. 세 개의 섬과 굽이치는 물가, 복원 전각이 시선을 계속 바꾸게 하며 신라인이 궁원에 담은 풍경 감각을 보여 줍니다. 1970년대 발굴에서는 건물터와 생활 유물이 대량으로 확인되어 왕궁 생활을 복원하는 중요한 단서가 됐습니다.","해 지기 30분쯤 전에 입장하면 낮 풍경과 조명이 켜지는 순간을 함께 볼 수 있어요. 주말 저녁은 혼잡하므로 평일을 권하며, 연못 반영은 바람이 잔잔한 날 동쪽 산책로에서 선명하게 담깁니다.","연못을 한 바퀴 돌며 전각이 물 위에서 가장 아름답게 겹치는 각도를 찾아보세요.","‘월지’라는 이름은 발굴된 토기 조각에 새겨진 글자 덕분에 확인됐어요. 기러기와 오리가 날아들어 훗날 ‘안압지’라고도 불렸답니다.");
db.commit();System.out.println("quality fixes committed");db.close();
/exit
